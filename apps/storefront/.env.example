# ---------------------------------------------------------------------------
# Nest Electronics storefront — environment template
#
# Copy to `.env.local` and adjust. `.env.local` is gitignored; only this
# template is tracked. NEVER put a real credential in this file.
#
# Local architecture for the API-backed pages under /shop:
#
#     Storefront (this app)  --HTTP-->  Nest API  -->  MongoDB
#
# Start the API first (`pnpm --filter api dev`, default port 3002), then this
# app. Nothing under /shop works without the API running.
# ---------------------------------------------------------------------------

# ---- Nest API -------------------------------------------------------------

# Base URL of the NestJS API, INCLUDING the /api/v1 prefix.
# Default when unset: http://127.0.0.1:3002/api/v1
#
# SERVER-ONLY, and deliberately NOT `NEXT_PUBLIC_API_BASE_URL`. The URL is not
# a secret; the reason is deployment.
#
# Next.js INLINES every NEXT_PUBLIC_ variable into the JavaScript bundle at
# BUILD time, which would bind each build to one API address — so the identical
# artifact could not be promoted from staging to production, and the thing
# tested in staging would not be the thing that ships. Read on the server, it
# is resolved at RUNTIME and one image runs everywhere.
#
# Every API call this app makes is server-side (`src/lib/api/client.ts` is
# `server-only`), so nothing in the browser needs it. The access and refresh
# tokens live in httpOnly cookies that client JavaScript cannot read, and never
# pass through the browser environment at all.
API_BASE_URL=http://127.0.0.1:3002/api/v1

# ---- Supabase (LEGACY pages only) -----------------------------------------
#
# Everything OUTSIDE /shop still reads Supabase directly. Those pages are being
# migrated to the API one at a time; until that finishes both stacks must be
# configured for the whole app to build and run.
#
# SUPABASE_SERVICE_ROLE_KEY is a SERVER-ONLY secret. It must never be given a
# NEXT_PUBLIC_ prefix — that would ship a full-privilege database key to every
# browser that loads the site.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ---- Logging --------------------------------------------------------------

# One of: debug | info | warn | error.  Default: info
# LOG_LEVEL=info

# ---------------------------------------------------------------------------
# CLASSIFICATION — what may be exposed to a browser
#
#   API_BASE_URL                    server-only  ·  required in every env
#   NEXT_PUBLIC_SUPABASE_URL        public       ·  required while legacy pages exist
#   NEXT_PUBLIC_SUPABASE_ANON_KEY   public       ·  required while legacy pages exist
#   SUPABASE_SERVICE_ROLE_KEY       SECRET       ·  server-only, never NEXT_PUBLIC_
#   LOG_LEVEL                       optional
#
# The rule: a NEXT_PUBLIC_ prefix ships the value to every visitor's browser
# and freezes it at build time. Use it only for a value that is genuinely
# public AND genuinely needed by client-side code.
#
# The API is reached SERVER-TO-SERVER, so the browser never holds a token and
# no CORS pre-flight is involved. Full analysis:
# docs/deployment/DEPLOYMENT-DECISION.md §5.
# ---------------------------------------------------------------------------
