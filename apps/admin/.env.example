# ---------------------------------------------------------------------------
# Nest Electronics admin — environment template
#
# Copy to `.env.local` and adjust. `.env.local` is gitignored; only this
# template is tracked. NEVER put a real credential in this file.
#
# The admin app still runs ENTIRELY on Supabase. Migrating it to the NestJS API
# is a separate, unscheduled phase — see docs/deployment/DEPLOYMENT-DECISION.md
# §8. It therefore needs no API variables today.
# ---------------------------------------------------------------------------

# ---- Supabase -------------------------------------------------------------

# Project URL and anon key. PUBLIC by design: the anon key is safe in a browser
# because row-level security, not secrecy, is what constrains it.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# SERVER-ONLY SECRET. Bypasses row-level security completely — it is effectively
# a full-privilege database credential.
#
# It must NEVER be given a NEXT_PUBLIC_ prefix. That single prefix would ship
# unrestricted database access to every browser that loads the admin site, and
# no amount of UI permission checking would matter.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ---------------------------------------------------------------------------
# CLASSIFICATION
#
#   NEXT_PUBLIC_SUPABASE_URL        public       ·  required
#   NEXT_PUBLIC_SUPABASE_ANON_KEY   public       ·  required
#   SUPABASE_SERVICE_ROLE_KEY       SECRET       ·  server-only, required
#
# There is deliberately no duplication of the API's secrets here. The admin app
# does not call the NestJS API, so it must not hold JWT_SECRET, MONGODB_URI or
# any mail credential — a secret copied into an application that does not need
# it is a second place it can leak from.
# ---------------------------------------------------------------------------
