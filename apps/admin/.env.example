# ---------------------------------------------------------------------------
# Nest Electronics admin — environment template
#
# Copy to `.env.local` and adjust. `.env.local` is gitignored; only this
# template is tracked. NEVER put a real credential in this file.
#
# As of Phase 6 the admin AUTHENTICATES against the NestJS API and reads ORDERS
# from it. Its other screens — products, categories, brands, coupons,
# inventory, reviews, customers, the dashboard statistics — are still on
# Supabase; moving those is Phase 7.
# ---------------------------------------------------------------------------

# ---- The API --------------------------------------------------------------

# Where the NestJS API lives, including the version prefix.
#
# SERVER-ONLY, and deliberately NOT `NEXT_PUBLIC_API_BASE_URL`. Next.js inlines
# every NEXT_PUBLIC_ variable into the bundle at BUILD time, so a build would be
# permanently bound to one API address and the identical artifact could not be
# promoted from staging to production. This is read at runtime, so one image
# runs in every environment.
#
# It is also not a secret — the distinction here is about deployment, not
# secrecy. Nothing in the browser needs it: the session lives in httpOnly
# cookies, so every authenticated call is made by the server.
API_BASE_URL=http://127.0.0.1:3002/api/v1

# ---- Supabase (the screens Phase 7 will move) -----------------------------

# Project URL and anon key. PUBLIC by design: the anon key is safe in a browser
# because row-level security, not secrecy, is what constrains it.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# ---------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY IS GONE, AND IT SHOULD NOT COME BACK
#
# It used to be required. `requireAdmin()` built a service-role Supabase client
# on every guarded navigation to read ONE column — `profiles.role` — and that
# key bypasses row-level security completely: it is effectively an unrestricted
# database login, held in this application's environment, to answer a question
# the API now answers with `GET /auth/me`.
#
# Nothing in `src/` reads it any more. If you find yourself adding it back,
# what you actually need is an API endpoint — the reason it was here was that
# there was no server that could be asked.
#
# CLASSIFICATION
#
#   API_BASE_URL                    public       ·  required
#   NEXT_PUBLIC_SUPABASE_URL        public       ·  required (until Phase 7)
#   NEXT_PUBLIC_SUPABASE_ANON_KEY   public       ·  required (until Phase 7)
#
# There is deliberately no duplication of the API's own secrets here. This app
# never signs a token — it asks the API to — so it must not hold JWT_SECRET,
# MONGODB_URI or any mail credential.
# ---------------------------------------------------------------------------
