# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env.local
# ...except the template, which documents the variable set and holds no values.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
# Run output, not source: `test-results/` holds the last-run marker, failure
# screenshots and traces, and `playwright-report/` the HTML report. All are
# regenerated by every run and meaningless in a diff. The storefront's
# .gitignore already carried these; the admin gained a Playwright suite in
# Phase 6 and needed the same entries.
/test-results/
/playwright-report/
/blob-report/
/.playwright/
/playwright/.cache/
