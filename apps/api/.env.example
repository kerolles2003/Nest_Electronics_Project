# ---------------------------------------------------------------------------
# Nest Electronics API — environment template
#
# Copy to `.env` (or `.env.local`) and adjust. Both are gitignored; only this
# template is tracked. NEVER put a real credential in this file.
#
# MONGODB_URI is REQUIRED — the API will not start without it, and has no
# degraded mode. Every other variable has a safe default. Invalid values fail
# at startup, never at request time, and every problem is reported at once.
#
# Production does not use a .env file — variables come from the platform
# secret store.
# ---------------------------------------------------------------------------

# ---- Application ----------------------------------------------------------

# One of: development | test | production
# Default: development
NODE_ENV=development

# HTTP port. Integer 1–65535.
# Default: 3002
PORT=3002

# First path segment of the API. The frozen contract serves /<prefix>/v1.
# Default: api  ->  /api/v1
API_PREFIX=api

# Expose Swagger UI at /<prefix>/v1/docs. One of: true | false | 1 | 0
# Default: enabled everywhere EXCEPT production.
# SWAGGER_ENABLED=true

# PUBLIC ORIGIN OF THE STOREFRONT — not of this API.
#
# Used to build the links a customer clicks from an email: the verification
# link and the order link. Get it wrong and every email points at a 404.
# Must be an absolute URL; a trailing slash is normalised away.
#
# Setting this to localhost while NODE_ENV=production FAILS AT STARTUP —
# verification links that only resolve on the deployer's laptop are worse than
# no deployment.
# Default: http://localhost:3000
SITE_URL=http://localhost:3000

# Comma-separated browser origins allowed to call this API with credentials.
#
# An ALLOW-LIST. Never a wildcard: the API sends `credentials: true`, and the
# Fetch spec forbids pairing that with `*`, so `*` would BREAK authenticated
# browser calls rather than merely loosening them.
#
# Empty (the default) allows no browser origin at all, which is correct for the
# current topology — the Next.js storefront calls this API from its SERVER, so
# no CORS pre-flight is involved. Fill it in only when a browser, or a second
# origin, genuinely calls the API directly.
#
#   CORS_ORIGINS=https://nestelectronics.com,https://admin.nestelectronics.com
CORS_ORIGINS=

# ---- Database -------------------------------------------------------------

# REQUIRED. MongoDB connection string. No default: it is a secret, and a
# defaulted secret silently reaches production.
#
# Treated as a secret throughout — never logged, never echoed in a validation
# error, never returned in a response.
#
# The frozen architecture requires a REPLICA SET (transactions need one; a
# standalone mongod cannot open a transactional session). For local
# development, docker-compose.dev.yml at the repository root provides a
# single-node replica set on 127.0.0.1:27017.
#
#   docker compose -f docker-compose.dev.yml up -d --wait
#
# ## The local URI is the DEVELOPMENT DEFAULT, and that is a decision, not a
# ## convenience.
#
# The test suite creates and deletes users, carts and orders. Pointed at a
# shared cloud cluster it risks other people's data, and a failed or
# interrupted run leaves debris somebody else has to find. A managed cluster
# is also slower and needs a credential in a file, for a database that is
# meant to be disposable.
#
# So: **Atlas is for staging and production, by explicit choice, and is never
# the development default.** If you need it for a deliberate staging task,
# set it for that command rather than editing this file:
#
#   MONGODB_URI=<staging uri> pnpm --filter api <task>
#
# Local (no credentials, disposable, replica set):
MONGODB_URI=mongodb://127.0.0.1:27017/nest_electronics_dev
#
# Atlas form, for staging/production only — replace every placeholder, and
# never commit a real value:
# MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.example.mongodb.net/YOUR_DB

# ---- Authentication ---------------------------------------------------------

# REQUIRED. HS256 signing key for access tokens. Minimum 32 characters.
#
# No default, deliberately: a defaulted signing key is a token-forgery
# vulnerability that reaches production silently. Treated as a secret
# throughout — never logged, never echoed in a validation error.
#
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=REPLACE_WITH_A_LOCALLY_GENERATED_KEY_OF_AT_LEAST_32_CHARS

# Access-token lifetime. Short by design — access tokens are NOT revocable.
# Format: <positive integer><s|m|h|d>.  Default: 15m
# JWT_ACCESS_TTL=15m

# Refresh-token lifetime. Long, but revocable and rotated on every use.
# Default: 30d
# JWT_REFRESH_TTL=30d

# bcrypt cost factor. Allowed 10-15.  Default: 12
# BCRYPT_ROUNDS=12

# Whether an unverified account may log in. Default: true.
#
# The frozen posture is that email verification is REQUIRED before login, and
# delivery now exists — the console provider prints the verification link to
# your terminal, so `true` is workable locally and is the recommended value.
#
# Setting it to false while NODE_ENV=production FAILS AT STARTUP: the escape
# hatch cannot escape.
AUTH_REQUIRE_EMAIL_VERIFICATION=true

# ---- Fulfilment (shipping cost policy) ------------------------------------
# THE authority for what delivery costs. Read once by FulfilmentService, which
# is the only expression in the system permitted to produce a shipping fee —
# checkout never writes a literal, and no client may send one.
#
# Both values are INTEGER MINOR UNITS (piastres), because MONEY-MODEL.md §5
# forbids a float anywhere a payable amount is derived. `50.5` is rejected at
# startup rather than rounded into somebody's total.

# Flat delivery fee, applied to every governorate.
# Default: 0 — deliberately. OPEN-001 records the per-governorate rate table as
# business input that has not been supplied, and a fabricated number presented
# to a customer as authoritative is worse than charging nothing. Raise it here
# when the real rate is known; nothing in checkout changes.
# SHIPPING_FLAT_FEE=0

# Order value at or above which delivery is free. Absent = no threshold.
# Compared against the POST-DISCOUNT subtotal (MONEY-MODEL.md §7.1), so a
# future coupon can carry an order over the line.
# FREE_SHIPPING_THRESHOLD=100000

# ---- Email (application level) --------------------------------------------
# Provider-agnostic. These move to a new vendor unchanged.

# Selects WHICH implementation transmits the mail. Read in exactly ONE place —
# ProvidersModule — and no business code ever branches on it.
#
# One of: console | resend | brevo
#
#   console  prints the message (including the verification link) to stdout.
#            No credentials, no network, works offline. THE local value.
#   resend   really sends. Requires RESEND_API_KEY below.
#   brevo    really sends. Requires BREVO_API_KEY below.
#
# Switching between the two vendors is exactly this one value plus its key.
# No business code, template or test changes — that is the whole point of the
# provider boundary (PROVIDER-ARCHITECTURE.md §5.7).
#
# `console` while NODE_ENV=production FAILS AT STARTUP: no mail would be
# delivered, and since verification is mandatory in production, every account
# created would be permanently unable to sign in while the API reported
# success.
EMAIL_PROVIDER=console

# The envelope sender. Read by the ADAPTER, never by business code, so nothing
# in the application can send from the wrong address.
#
# In production this must be an address at a domain whose SPF and DKIM records
# authorise the SELECTED provider — a DNS fact no schema can verify, and one
# that is provider-specific: a domain verified with Resend is NOT thereby
# verified with Brevo. Switching vendors means re-publishing DNS records.
#
# The default below is a PLACEHOLDER and is meant to be replaced. `.invalid` is
# reserved by RFC 2606 and can never resolve, so it cannot deliver mail to
# anyone — which is exactly why it is the default. The previous default was
# Resend's shared sandbox sender `onboarding@resend.dev`: a real, deliverable
# address belonging to ONE vendor, which meant a deployment that forgot to set
# a sender inherited a Resend identity while EMAIL_PROVIDER said `brevo` (F-02).
# That mismatch fails even with a valid key.
#
# Leave it as-is for local development: with EMAIL_PROVIDER=console nothing is
# transmitted, so the sender is only a line of printed text. The API refuses to
# start with this value when NODE_ENV=production.
#
# The real sender arrives with the Brevo production line (Phase E), on a domain
# the owner controls and has verified WITH BREVO (a domain verified with Resend
# is not thereby verified with Brevo), together with its SPF/DKIM records.
# Default: no-reply@nest-electronics.invalid
EMAIL_FROM_ADDRESS=no-reply@nest-electronics.invalid

# Display name beside the from-address. Default: Nest Electronics
EMAIL_FROM_NAME=Nest Electronics

# Where a customer's reply goes. Absent means replies go to the from-address —
# which, for a no-reply sender, means they vanish. Strongly advised in
# production; deliberately not mandatory, so a team without a support inbox is
# not blocked from deploying.
# EMAIL_REPLY_TO=support@example.com

# ---- Email (vendor level) -------------------------------------------------
# Read ONLY by the Resend adapter, through its own config namespace. No
# application-level code can reach it.

# Each is required ONLY when its provider is selected; choosing `console` must
# not demand either. Both are treated as secrets throughout — never logged,
# never echoed in a validation error. Leave commented out unless you are
# actually using that vendor.
#
# Only the SELECTED adapter is ever constructed, so the unused key is never
# read even if it is present.

# RESEND_API_KEY=YOUR_RESEND_API_KEY_HERE

# Brevo (formerly Sendinblue). Create at:
#   Brevo dashboard -> SMTP & API -> API Keys
# BREVO_API_KEY=YOUR_BREVO_API_KEY_HERE

# ---------------------------------------------------------------------------
# Not yet implemented. Each arrives with the phase that consumes it, together
# with its schema entry and typed namespace — deliberately absent here so this
# file never lists a variable that does nothing:
#
#   database       MONGODB_DB_NAME (the db name travels in MONGODB_URI today)
#   media          MEDIA_PROVIDER, CLOUDINARY_*
#   rate limiting  THROTTLE_ENABLED, THROTTLE_TTL, THROTTLE_LIMIT
#   observability  LOG_LEVEL, SENTRY_DSN, SENTRY_RELEASE
#   admin alerts   ADMIN_ALERT_EMAIL (the new-order alert is not built yet)
#
# Full frozen inventory: docs/architecture/CONFIGURATION-ARCHITECTURE.md §9
# ---------------------------------------------------------------------------
