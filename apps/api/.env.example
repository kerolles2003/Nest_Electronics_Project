# ---------------------------------------------------------------------------
# Nest Electronics API — environment template
#
# Copy to `.env` (or `.env.local`) and adjust. Both are gitignored; only this
# template is tracked. NEVER put a real credential in this file.
#
# MONGODB_URI is REQUIRED — the API will not start without it, and has no
# degraded mode. Every other variable has a safe default. Invalid values fail
# at startup, never at request time, and every problem is reported at once.
#
# Production does not use a .env file — variables come from the platform
# secret store.
# ---------------------------------------------------------------------------

# ---- Application ----------------------------------------------------------

# One of: development | test | production
# Default: development
NODE_ENV=development

# HTTP port. Integer 1–65535.
# Default: 3002
PORT=3002

# First path segment of the API. The frozen contract serves /<prefix>/v1.
# Default: api  ->  /api/v1
API_PREFIX=api

# Expose Swagger UI at /<prefix>/v1/docs. One of: true | false | 1 | 0
# Default: enabled everywhere EXCEPT production.
# SWAGGER_ENABLED=true

# ---- Database -------------------------------------------------------------

# REQUIRED. MongoDB connection string. No default: it is a secret, and a
# defaulted secret silently reaches production.
#
# Treated as a secret throughout — never logged, never echoed in a validation
# error, never returned in a response.
#
# The frozen architecture requires a REPLICA SET (transactions need one; a
# standalone mongod cannot open a transactional session). For local
# development, docker-compose.dev.yml at the repository root provides a
# single-node replica set on 127.0.0.1:27017.
#
#   docker compose -f docker-compose.dev.yml up -d
#
# Local (no credentials):
MONGODB_URI=mongodb://127.0.0.1:27017/nest_electronics_dev
#
# Atlas form — replace every placeholder; never commit a real value:
# MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.example.mongodb.net/YOUR_DB

# ---- Authentication ---------------------------------------------------------

# REQUIRED. HS256 signing key for access tokens. Minimum 32 characters.
#
# No default, deliberately: a defaulted signing key is a token-forgery
# vulnerability that reaches production silently. Treated as a secret
# throughout — never logged, never echoed in a validation error.
#
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=REPLACE_WITH_A_LOCALLY_GENERATED_KEY_OF_AT_LEAST_32_CHARS

# Access-token lifetime. Short by design — access tokens are NOT revocable.
# Format: <positive integer><s|m|h|d>.  Default: 15m
# JWT_ACCESS_TTL=15m

# Refresh-token lifetime. Long, but revocable and rotated on every use.
# Default: 30d
# JWT_REFRESH_TTL=30d

# bcrypt cost factor. Allowed 10-15.  Default: 12
# BCRYPT_ROUNDS=12

# Whether an unverified account may log in. Default: true.
#
# The frozen posture is that email verification is REQUIRED before login.
# Delivery belongs to NotificationsModule, which does not exist yet, so local
# development sets this to false. Setting it to false while NODE_ENV=production
# FAILS AT STARTUP — the escape hatch cannot escape.
AUTH_REQUIRE_EMAIL_VERIFICATION=true

# ---- Fulfilment (shipping cost policy) ------------------------------------
# THE authority for what delivery costs. Read once by FulfilmentService, which
# is the only expression in the system permitted to produce a shipping fee —
# checkout never writes a literal, and no client may send one.
#
# Both values are INTEGER MINOR UNITS (piastres), because MONEY-MODEL.md §5
# forbids a float anywhere a payable amount is derived. `50.5` is rejected at
# startup rather than rounded into somebody's total.

# Flat delivery fee, applied to every governorate.
# Default: 0 — deliberately. OPEN-001 records the per-governorate rate table as
# business input that has not been supplied, and a fabricated number presented
# to a customer as authoritative is worse than charging nothing. Raise it here
# when the real rate is known; nothing in checkout changes.
# SHIPPING_FLAT_FEE=0

# Order value at or above which delivery is free. Absent = no threshold.
# Compared against the POST-DISCOUNT subtotal (MONEY-MODEL.md §7.1), so a
# future coupon can carry an order over the line.
# FREE_SHIPPING_THRESHOLD=100000

# ---- Email provider selection ---------------------------------------------
# Selects WHICH implementation is used. No SDK is initialised by this phase,
# and no business code ever branches on this value.
#
# One of: console | resend
# Default: console — logs instead of sending, needs no credentials, works
# offline. This is the intended local-development value.
EMAIL_PROVIDER=console

# Required ONLY when EMAIL_PROVIDER=resend. Selecting `console` must not
# demand it. Leave commented out unless you are actually using Resend.
# RESEND_API_KEY=YOUR_RESEND_API_KEY_HERE

# ---------------------------------------------------------------------------
# Not yet implemented. Each arrives with the phase that consumes it, together
# with its schema entry and typed namespace — deliberately absent here so this
# file never lists a variable that does nothing:
#
#   database       MONGODB_DB_NAME (the db name travels in MONGODB_URI today)
#   media          MEDIA_PROVIDER, CLOUDINARY_*
#   email (app)    EMAIL_FROM_ADDRESS, EMAIL_FROM_NAME, EMAIL_REPLY_TO
#   http           SITE_URL, CORS_ORIGINS
#   rate limiting  THROTTLE_ENABLED, THROTTLE_TTL, THROTTLE_LIMIT
#   observability  LOG_LEVEL, SENTRY_DSN, SENTRY_RELEASE
#
# Full frozen inventory: docs/architecture/CONFIGURATION-ARCHITECTURE.md §9
# ---------------------------------------------------------------------------
