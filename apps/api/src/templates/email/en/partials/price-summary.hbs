{{!--
  The totals block.

  `hasDiscount`, `shippingUnpriced` and `shippingFree` are BOOLEANS computed by
  NotificationsService, not conditions evaluated here. "Show the discount row
  when a discount applies" is a business rule, and business rules that live in
  templates are untestable — the reason a logic-less engine was chosen.

  Expects: itemsSubtotal, hasDiscount, discountTotal, shippingUnpriced,
           shippingFree, shippingFee, grandTotal, paymentMethod,
           amountDueOnDelivery
--}}
<table
  role="presentation"
  width="100%"
  cellpadding="0"
  cellspacing="0"
  border="0"
  style="margin:8px 0 4px 0;"
>
  <tr>
    <td style="padding:3px 0;color:#52525b;">Subtotal</td>
    <td align="right" style="padding:3px 0;color:#52525b;">{{itemsSubtotal}}</td>
  </tr>

  {{#if hasDiscount}}
  <tr>
    <td style="padding:3px 0;color:#15803d;">Discount</td>
    <td align="right" style="padding:3px 0;color:#15803d;">&minus;{{discountTotal}}</td>
  </tr>
  {{/if}}

  <tr>
    <td style="padding:3px 0;color:#52525b;">Delivery</td>
    <td align="right" style="padding:3px 0;color:#52525b;">
      {{#if shippingUnpriced}}Calculated before dispatch{{else}}{{#if shippingFree}}Free{{else}}{{shippingFee}}{{/if}}{{/if}}
    </td>
  </tr>

  <tr>
    <td style="padding:10px 0 0 0;border-top:1px solid #e4e4e7;font-weight:800;font-size:16px;">
      Total
    </td>
    <td
      align="right"
      style="padding:10px 0 0 0;border-top:1px solid #e4e4e7;font-weight:800;font-size:16px;"
    >
      {{grandTotal}}
    </td>
  </tr>
</table>

<p
  style="margin:16px 0 0 0;padding:12px 14px;background-color:#fafafa;border:1px solid #e4e4e7;border-radius:8px;font-size:14px;color:#3f3f46;"
>
  <strong>{{paymentMethod}}</strong><br />
  Please have <strong>{{amountDueOnDelivery}}</strong> ready when your order arrives.
</p>
