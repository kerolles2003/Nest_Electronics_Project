{{!--
  The ordered lines.

  Every money value is printed exactly as it arrives. There is no arithmetic
  here and there cannot be: Handlebars is logic-less, which is precisely why
  it was chosen for the email path.

  Expects: items[] { name, quantity, unitPrice, lineTotal }
--}}
<table
  role="presentation"
  width="100%"
  cellpadding="0"
  cellspacing="0"
  border="0"
  style="margin:16px 0;border-collapse:collapse;"
>
  <tr>
    <th
      align="left"
      style="padding:0 0 8px 0;border-bottom:1px solid #e4e4e7;font-size:12px;text-transform:uppercase;letter-spacing:0.04em;color:#71717a;font-weight:600;"
    >
      Item
    </th>
    <th
      align="right"
      style="padding:0 0 8px 0;border-bottom:1px solid #e4e4e7;font-size:12px;text-transform:uppercase;letter-spacing:0.04em;color:#71717a;font-weight:600;"
    >
      Total
    </th>
  </tr>

  {{#each items}}
  <tr>
    <td style="padding:10px 8px 10px 0;border-bottom:1px solid #f4f4f5;vertical-align:top;">
      <span style="color:#18181b;">{{this.name}}</span><br />
      <span style="font-size:13px;color:#71717a;"
        >{{qty this.quantity}} &times; {{this.unitPrice}}</span
      >
    </td>
    <td
      align="right"
      style="padding:10px 0;border-bottom:1px solid #f4f4f5;vertical-align:top;white-space:nowrap;"
    >
      {{this.lineTotal}}
    </td>
  </tr>
  {{/each}}
</table>
